PORT=4001
NODE_ENV=DEVELOPMENT
FRONTEND_URL=http://localhost:5173

# MongoDB Atlas or Local MongoDB Connection
DB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_TIME=7d
COOKIE_EXPIRES_TIME=7

# Email Service (e.g., Mailtrap, SendGrid, Gmail)
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_EMAIL=your_smtp_user
SMTP_PASSWORD=your_smtp_password
SMTP_FROM_EMAIL=noreply@dosnoventa.com
SMTP_FROM_NAME=Dosnoventa
